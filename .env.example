# Base de datos PostgreSQL Asíncrona (asyncpg)
# Opción A: URL completa (tiene prioridad sobre las opciones individuales)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/taller_mecanico

# Opción B: Componentes individuales (se ignoran si DATABASE_URL está definido)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller_mecanico
POSTGRES_PORT=5432

# Configuración de la aplicación
DEBUG=false
API_V1_STR=/api/v1

# Seguridad - SENSIBLES: cambiar en producción
SECRET_KEY=change-me-in-production-to-a-very-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Administrador inicial (seed) - SENSIBLES
FIRST_ADMIN_EMAIL=admin@taller.com
FIRST_ADMIN_PASSWORD=admin123