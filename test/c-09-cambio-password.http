@host = http://localhost:8000

# Antes de ejecutar: python seed.py
# Seed: nuevo (id=7) tiene debe_cambiar_password=True, rol MECANICO

### Login nuevo (debe cambiar password)
# @name loginNuevo
# @no-cookie-jar
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "nuevo@example.com",
  "password": "Secreta123!"
}

---

### C-09: Con debe_cambiar_password=True, endpoints protegidos -> 403 salvo /auth/cambiar-password
# @no-cookie-jar
GET {{host}}/ordenes
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

###
### C-09: /auth/yo muestra debe_cambiar_password=true
# @no-cookie-jar
GET {{host}}/auth/yo
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

---

### C-09: Cambio obligatorio de password -> 200, nueva cookie, debe_cambiar_password=false
# @name loginNuevo2
# @no-cookie-jar
POST {{host}}/auth/cambiar-password
Content-Type: application/json
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

{
  "password_actual": "Secreta123!",
  "password_nueva": "NuevaClaveSegura123!"
}

###
### C-09: Después del cambio, cookie nueva vale, anterior da 401
# @no-cookie-jar
GET {{host}}/ordenes
Cookie: {{loginNuevo2.response.headers.Set-Cookie}}

###
### C-09: Cookie anterior (loginNuevo) ya no funciona -> 401
# @no-cookie-jar
GET {{host}}/ordenes
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

###
### C-09: Login con nueva password funciona
# @name loginNuevo3
# @no-cookie-jar
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "nuevo@example.com",
  "password": "NuevaClaveSegura123!"
}

###
# @no-cookie-jar
GET {{host}}/ordenes
Cookie: {{loginNuevo3.response.headers.Set-Cookie}}